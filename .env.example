# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/support_ticket

# Redis
REDIS_URL=redis://localhost:6379/0

# IMAP (incoming email)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=support@yourcompany.com
IMAP_PASS=your_imap_app_password

# SMTP (outgoing email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=support@yourcompany.com
SMTP_PASS=your_smtp_app_password

# CRM Portal
CRM_PORTAL_URL=https://crm.yourcompany.com
CRM_USER=crm_automation_user
CRM_PASS=crm_automation_password

# Paths
SCREENSHOTS_DIR=/app/screenshots

# Logging
LOG_LEVEL=INFO

# SLA configuration (hours)
SLA_CRITICAL_HOURS=2
SLA_HIGH_HOURS=8
SLA_NORMAL_HOURS=24

# Escalation
ESCALATION_EMAIL=manager@yourcompany.com

# ML model
CLASSIFIER_MODEL_PATH=/app/models/ticket_classifier.pkl
